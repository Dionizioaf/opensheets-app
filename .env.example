# ============================================
# OPENSHEETS - Variáveis de Ambiente
# ============================================

# === Database ===
# PostgreSQL local (Docker): use host "db"
# PostgreSQL local (sem Docker): use host "localhost"
# PostgreSQL remoto: use URL completa do provider
DATABASE_URL=postgresql://opensheets:opensheets_dev_password@db:5432/opensheets_db

# Credenciais do PostgreSQL (apenas para Docker local) - Alterar
POSTGRES_USER=opensheets
POSTGRES_PASSWORD=opensheets_dev_password
POSTGRES_DB=opensheets_db

# Provider: "local" para Docker, "remote" para Supabase/Neon/etc
DB_PROVIDER=local

# === Better Auth ===
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-here-change-this
BETTER_AUTH_URL=http://localhost:3000

# === Portas ===
APP_PORT=3000
DB_PORT=5432

# === Email (Opcional) ===
# Provider: Resend (https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com

# === OAuth (Opcional) ===
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === AI Providers (Opcional) ===
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
# OpenOllama/Ollama OpenAI-compatible endpoint (default: http://localhost:11434/v1)
OPENOLLAMA_BASE_URL=http://localhost:11434/v1
OPENOLLAMA_API_KEY=openollama
AI_CATEGORIZATION_ENABLED=false
NEXT_PUBLIC_AI_CATEGORIZATION_ENABLED=false

# === MCP local para Claude (Opcional) ===
# Configure exatamente um identificador de usuário.
OPENSHEETS_MCP_USER_ID=
OPENSHEETS_MCP_USER_EMAIL=
# readonly (padrão) | safe-writes | full
OPENSHEETS_MCP_WRITE_MODE=readonly

# === MCP remoto via HTTP (Docker) ===
# Gere com: openssl rand -hex 32. Obrigatório para o endpoint público.
MCP_HTTP_AUTH_TOKEN=change-this-to-a-long-random-token
# Use * para clientes públicos ou uma lista separada por vírgulas para restringir CORS.
MCP_HTTP_ALLOWED_ORIGINS=*
MCP_PORT=8787

# === OFX Import Rate Limiting ===
# Maximum number of OFX imports per user per time window
OFX_RATE_LIMIT_MAX_IMPORTS=10
# Rate limit time window in milliseconds (default: 1 hour = 3600000)
OFX_RATE_LIMIT_WINDOW_MS=3600000
